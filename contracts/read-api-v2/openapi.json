          "cpu_system_seconds",
          "rss_bytes",
          "peak_rss_bytes"
        ],
        "title": "Resources",
        "description": "Cumulative CPU and current and peak resident memory of a process tree."
      },
      "RunBlock": {
        "properties": {
          "phase": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
