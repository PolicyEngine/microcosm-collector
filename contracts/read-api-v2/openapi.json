{
  "openapi": "3.1.0",
  "info": {
    "title": "Microcosm collector read API",
    "version": "2",
    "description": "Version 2 of the Microcosm collector's read API. Each request carries the dashboard read credential in `X-Telemetry-Read-Token`. While a deployment is in progress, every request may answer 503 with `Retry-After`."
  },
  "paths": {
    "/v2/runs": {
      "get": {
        "tags": [
          "read API v2"
        ],
        "summary": "List runs, newest registration first",
        "operationId": "listRuns",
        "security": [
          {
            "ReadToken": []
          }
        ],
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only runs of this country, such as `US` or `GB`.",
              "title": "Country"
            },
            "description": "Only runs of this country, such as `US` or `GB`."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "The most runs to return.",
              "default": 60,
              "title": "Limit"
            },
            "description": "The most runs to return."
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The previous page's `next_before`.",
              "title": "Before"
            },
            "description": "The previous page's `next_before`."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPage"
                }
              }
            }
          },
          "401": {
            "description": "The read credential is missing or wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "503": {
            "description": "A deployment is in progress; retry after the `Retry-After` header's seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v2/runs/{run_id}": {
      "get": {
        "tags": [
          "read API v2"
        ],
        "summary": "A run's state and the events it was rebuilt from",
        "operationId": "getRun",
        "security": [
          {
            "ReadToken": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunDetail"
                }
              }
            }
          },
          "401": {
            "description": "The read credential is missing or wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "503": {
            "description": "A deployment is in progress; retry after the `Retry-After` header's seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "The run was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
